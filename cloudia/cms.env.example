# Copy to cms.env (ignored by git) and fill in what this site needs. Empty values are ignored.

# The address visitors use, with scheme and no trailing slash. Used in emails and absolute links.
PUBLIC_URL=

# Outgoing mail for form notifications and password resets. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: timezone for the analytics digest weekday and hour (UTC when unset).
# TZ=Africa/Johannesburg

# A random secret that anonymises visitor addresses in the form throttle. Generate once, keep it.
FORM_SALT=

# Local backups: pre-upgrade and daily archives in cms-backups/ are deleted after this many days.
BACKUP_KEEP_DAYS=14

# Optional: copy each backup to an S3-compatible bucket (needs the S3_* settings below).
BACKUP_S3_BUCKET=

# Optional: keep uploaded media in an S3-compatible bucket instead of the cms_data volume.
MEDIA_S3_BUCKET=

# Optional: S3-compatible storage used by the two buckets above (R2, B2, MinIO, AWS).
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Optional: a read:packages token so the dashboard can check GitHub for newer releases.
CLOUDIA_REGISTRY_TOKEN=
