# Copy to .env on the VPS before running docker-compose.prod.yml.
# Used by Caddy to request the TLS certificate and route traffic.
DOMAIN=zic.parts-mall.co.za

# Analytics are CloudIA's own (cookieless, see lib/analytics.ts); nothing to
# set here. The CMS reads cloudia/cms.env (see cloudia/cms.env.example).
# Optional. Google Search Console HTML-tag verification code (the value only, not the
# full <meta> tag).
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional. Leave unset and the enquiry form still works — it just logs
# submissions server-side instead of emailing them (see lib/mailer.ts and
# app/api/enquire/route.ts). Read at RUNTIME, not build time — unlike the
# NEXT_PUBLIC_* vars above, this is a real secret and is passed to the
# container as an environment variable, never as a Docker build arg (see
# docker-compose.prod.yml).
# Resend API key (resend.com/api-keys).
RESEND_API_KEY=
# Sender address. Defaults to Resend's shared sandbox sender, which needs no
# domain verification but can only deliver to the account owner's own
# address — fine for a first test, not for real leads. Deliberately
# skzic.co.za, not parts-mall.co.za/parts-mall.com — those already run live
# company email elsewhere, so verifying them risks the SPF record for every
# other email the company sends. skzic.co.za has no MX/SPF/DMARC records at
# all, so it's a clean, zero-risk domain to verify for this. Once verified
# in the Resend dashboard, set this to something like:
# SK ZIC Website <enquiries@skzic.co.za>
RESEND_FROM_EMAIL=
