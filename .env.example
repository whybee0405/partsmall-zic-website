# Copy to .env on the VPS before running docker-compose.prod.yml.
# Used by Caddy to request the TLS certificate and route traffic.
DOMAIN=zic.parts-mall.co.za

# Optional. Leave unset until each is actually ready to go live — both are
# no-ops when empty (see components/Analytics.tsx and app/layout.tsx).
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Loads on every page (Consent Mode
# v2 — see components/Analytics.tsx); full tracking still only starts once a
# visitor accepts the cookie banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification code (the value only, not the
# full <meta> tag).
NEXT_PUBLIC_GSC_VERIFICATION=
